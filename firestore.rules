rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
         request.auth.token.role == 'admin');
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // CMS Main Document & Settings (Collection: cms, Document: main)
    match /cms/{docId} {
      allow read, write: if true;
    }

    // Public published content (Services, Products, Content, SEO, FAQs, Prompts)
    match /services/{serviceId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }

    match /prompts/{promptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /websiteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Private user consultations & submissions (Wardrobe Capsule, Contact Messages)
    match /wardrobeSubmissions/{subId} {
      allow create: if true;
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read: if isOwner(resource.data.userId) || isOwner(resource.data.customerEmail) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /contactMessages/{messageId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /salesLeads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Admin & Security Collections
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false; // Immutable audit trail
    }

    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
